<?xml version="1.0" encoding="utf-8"?>

<!--
This file is used for additional steps in the build for iOS(mainly for adding additional information to the *.plist).
It uses its own UPL language, written by the developers of Unreal Engine 4. 
The official documentation does not specify the steps for iOS, but you can learn more from the source code:
https://github.com/EpicGames/UnrealEngine/blob/release/Engine/Source/Programs/UnrealBuildTool/System/UnrealPluginLanguage.cs
-->

<root>

    <!-- =============================================================================================== -->
    <init>
        <log text="Stash iOS -> Adding permission to plist"/>
        <log text="Stash iOS -> Including Stash Native SDK"/>

        <!-- Opt-in UPL debug: set STASH_UPL_VERBOSE=1 before packaging (see README Debugging). -->
        <setBoolEnvVarDefined result="bStashUplVerbose" value="%STASH_UPL_VERBOSE%"/>
        <if condition="bStashUplVerbose">
            <true>
                <trace enable="true"/>
                <dumpvars/>
            </true>
        </if>
    </init>

    <!-- Copy pre-built StashNative XCFramework -->
    <copyFiles>
        <copyDir src="$S(PluginDir)/ThirdParty/iOS/StashNative.xcframework"
                 dst="$S(BuildDir)/Frameworks/StashNative.xcframework" />
    </copyFiles>

</root>
