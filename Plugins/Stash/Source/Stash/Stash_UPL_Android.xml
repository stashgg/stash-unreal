<?xml version="1.0" encoding="utf-8"?>

<!--
This file is used for additional steps in the gradle build for Android.
It uses its own UPL language written by the developers of Unreal Engine 4. To learn more, see the documentation:
https://docs.unrealengine.com/en-US/SharingAndReleasing/Mobile/UnrealPluginLanguage/index.html
-->

<root xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Initializing XML variables  ============================================================================= -->
  <init>
    <log text="Stash Android -> Adding properties to Manifest and Gradle"/>

    <!-- Opt-in UPL debug: set STASH_UPL_VERBOSE=1 before packaging (see README Debugging). -->
    <setBoolEnvVarDefined result="bStashUplVerbose" value="%STASH_UPL_VERBOSE%"/>
    <if condition="bStashUplVerbose">
      <true>
        <trace enable="true"/>
        <dumpvars/>
      </true>
    </if>
    
    <setBool result="bSupported" value="false"/>

    <isArch arch="armeabi-v7a">
      <setBool result="bSupported" value="true"/>
    </isArch>

    <isArch arch="arm64-v8a">
      <setBool result="bSupported" value="true"/>
    </isArch>

    <if condition="bSupported">
      <false>
        <log text="WARNING: Stash Native is not supported on this Android architecture (requires armeabi-v7a or arm64-v8a)."/>
      </false>
    </if>
  </init>


  <!-- These files are copied during build to the linker, and the dst must match package in (*. java)  =============================== -->
  <prebuildCopies>
    <copyDir src="$S(PluginDir)/Private/Android/Java" dst="$S(BuildDir)/src/com/Plugins/Stash" />
  </prebuildCopies>


  <!-- Library data is copied to the linker during build. Optional files or directories to copy or delete from Intermediate/Android/APK after ndk-build -->
  <resourceCopies>

    <!-- Example of adding*. so dynamic libraries when building android for different architectures. -->
    <!-- libc++_shared.so already added, but if you use the engine version 4.24 or less, you can uncomment these lines -->
    
    <isArch arch="armeabi-v7a">      
      <!-- <copyFile src="$S(PluginDir)/ThirdParty/Android/armeabi-v7a/lib/libc++_shared.so"
                dst="$S(BuildDir)/libs/armeabi-v7a/libc++_shared.so" /> -->
    </isArch>

    <isArch arch="arm64-v8a">
      <!-- <copyFile src="$S(PluginDir)/ThirdParty/Android/arm64-v8a/lib/libc++_shared.so"
                dst="$S(BuildDir)/libs/arm64-v8a/libc++_shared.so" /> -->
    </isArch>
  </resourceCopies>


  <!-- optional properties to add to gradle.properties -->
  <gradleProperties>
    <insert>
      android.useAndroidX=true
      android.enableJetifier=true
    </insert>
  </gradleProperties>

  <!-- Declare your own classes -->
  <!-- ProGuard keeps — see README "Third-party libraries & ProGuard". -->
  <proguardAdditions>
    <insert>
      <!-- Disabling class obfuscation -->
      -dontwarn com.Plugins.**
      -keep class com.Plugins.** { *; }
      -keep interface com.Plugins.** { *; }
      -keep public class com.Plugins.Stash.** { public protected *; }

      <!-- Stash Native SDK classes.
           AND-03 / AND-10: the full "-keep class com.stash.** { *; }" is REQUIRED by StashHelper.java's
           purchase-processing reflection into stash-native PRIVATE fields/classes (StashNativeCard.plugin,
           plugin.webView, plugin.currentDialog, StashNativeCardPortraitActivity.isPurchaseProcessing/webView).
           R8 would strip those private members without this keep. Keep coupled to that reflection — only
           narrow this rule if/when StashHelper.java's reflection is removed. -->
      -dontwarn com.stash.**
      -keep class com.stash.** { *; }
      -keep interface com.stash.** { *; }

      <!-- AND-10: narrowed from a blanket androidx.** keep to only what the SDK touches (verified in the
           2.3.0 AAR: androidx.browser, androidx.core, androidx.webkit). The AAR ships its own consumer
           rules for its public API; keeping all of AndroidX cost real APK size under R8. -->
      -dontwarn androidx.browser.**
      -keep class androidx.browser.** { *; }
      -dontwarn androidx.webkit.**
      -keep class androidx.webkit.** { *; }
      -dontwarn androidx.core.app.**
      -keep class androidx.core.app.** { *; }

      <!-- AND-10: removed dead "-keep class com.facebook.** { *; }" — zero Facebook classes exist in the AAR. -->
    </insert>
  </proguardAdditions>


  <!-- Enable libraries in the app itself (Sometimes you don't need to). Optional libraries to load in GameActivity.java before libUE4.so -->
  <soLoadLibrary>
    <!--<loadLibrary name="c++_shared" failmsg="XML! libc++_shared.so library not loaded and required!" />-->
  </soLoadLibrary>


  <!-- optional updates applied to AndroidManifest.xml -->
  <!-- Manifest permissions merged here — see README "Manifest permissions & privacy review". -->
  <androidManifestUpdates>

    <!-- AND-11: UE4 / ≤5.2 compat only — no-op on newer engines. Matches "com.epicgames.ue4.SplashActivity";
         UE5 renamed it to com.epicgames.unreal.SplashActivity and UE 5.7's deploy already emits
         android:exported="true", so this loop matches nothing on the UE5 engines this plugin targets. -->
    <loopElements tag="activity">
      <setStringFromAttribute result="activityName" tag="$" name="android:name"/>
      <setBoolIsEqual result="bSplashActivity" arg1="$S(activityName)" arg2="com.epicgames.ue4.SplashActivity"/>
      <if condition="bSplashActivity">
        <true>
          <addAttribute tag="$" name="android:exported" value="true"/>
        </true>
      </if>
    </loopElements>

    <!-- AND-07: removed the AD_ID permission add and the WRITE/READ_EXTERNAL_STORAGE edits — none relate to
         Stash Pay checkout (template leftovers that forced Play Data-safety declarations onto every integrator).
         The StashNative AAR manifest already merges INTERNET + foreground-service permissions, which is all
         checkout needs. (Paired with DOC-13 on the README side.) -->


    <!-- add Elements -->
    <addElements tag="application">
      <!-- Your lines that you want to add to the "application" section -->

      <!-- 
      EXAMPLE!
      <addAttribute tag="application" name="android:requestLegacyExternalStorage" value="true"/>
      -->

    </addElements>
    
  </androidManifestUpdates>


  <!-- optional app build.gradle additions -->
  <buildGradleAdditions>
    <insert>
      <!-- AND-09: removed the ext{ android{ compileSdkVersion 35; buildTypes.release.minifyEnabled false } }
           override. A third-party payment plugin must not silently force the host app's compile SDK or
           disable release minification app-wide. The plugin's ProGuard keeps above already protect the SDK
           if the game enables minification. -->
      repositories {
        mavenCentral()
        flatDir {
          dirs 'libs'
        }
      }
    </insert>

    <!-- androidx.core:1.13.x pulls kotlin-stdlib 1.8.x; other deps may still pull kotlin-stdlib-jdk7/jdk8 1.6.x,
         which duplicate classes merged into kotlin-stdlib 1.8+ → checkDebugDuplicateClasses fails. -->
    <insert>
      configurations.all {
        resolutionStrategy.eachDependency { details ->
          if (details.requested.group == 'org.jetbrains.kotlin') {
            details.useVersion '1.8.22'
          }
        }
      }
    </insert>

    <!-- dependencies *.AAR libraries -->
    <insert>
      dependencies {
      // AND-08: removed okhttp (×2), com.google.android.play:review, guava, and androidx.work:work-runtime —
      // a constant-pool scan of the 2.3.0 AAR shows ZERO references to any of them (okhttp 3.12.x is also EOL
      // since 2021 with known CVEs). The SDK references only androidx.browser/core/webkit (+ annotation).
      implementation 'androidx.annotation:annotation:1.0.0'

      // Stash Native 2.1+ keep-alive calls ServiceCompat.startForeground(Service, int, Notification, int).
      // UE4's default transitive androidx.core is often too old → NoSuchMethodError without an explicit pin.
      implementation 'androidx.core:core:1.13.1'

      // Stash Native SDK - pre-built AAR (see gradleCopies StashNative-*.aar → libs/StashNative.aar)
      implementation(name: 'StashNative', ext: 'aar')

      // Dependencies required by Stash Native SDK
      implementation 'androidx.browser:browser:1.7.0'
      implementation 'androidx.webkit:webkit:1.5.0'
      }
    </insert>

  </buildGradleAdditions>


  <!-- optional base build.gradle additions -->
  <!--
    AndroidX migration: beforeEvaluate walks every .java under the UE-generated Gradle rootProject
    (Intermediate/Android/.../gradle/, not the game C++ repo) and replaces legacy android.support.*
    strings with androidx.* mappings. Logs "Updating ... in file ..." per hit. See README
    "Android build integration (Stash_UPL_Android.xml)".
  -->
  <baseBuildGradleAdditions>
    <insert>
      allprojects {
        def mappings = [
          'android.support.annotation': 'androidx.annotation',
          'android.arch.lifecycle': 'androidx.lifecycle',
          'android.support.v4.app.NotificationCompat': 'androidx.core.app.NotificationCompat',
          'android.support.v4.app.ActivityCompat': 'androidx.core.app.ActivityCompat',
          'android.support.v4.content.ContextCompat': 'androidx.core.content.ContextCompat',
          'android.support.v4.app.NotificationManagerCompat': 'androidx.core.app.NotificationManagerCompat',
          'android.support.v4.content.FileProvider': 'androidx.core.content.FileProvider',
          'android.support.v13.app.FragmentCompat': 'androidx.legacy.app.FragmentCompat',
          'android.arch.lifecycle.Lifecycle': 'androidx.lifecycle.Lifecycle',
          'android.arch.lifecycle.LifecycleObserver': 'androidx.lifecycle.LifecycleObserver',
          'android.arch.lifecycle.OnLifecycleEvent': 'androidx.lifecycle.OnLifecycleEvent',
          'android.arch.lifecycle.ProcessLifecycleOwner': 'androidx.lifecycle.ProcessLifecycleOwner',
        ]

      beforeEvaluate { project ->
        project.rootProject.projectDir.traverse(type: groovy.io.FileType.FILES, nameFilter: ~/.*\.java$/) { f ->
            mappings.each { entry ->
              if (f.getText('UTF-8').contains(entry.key)) {
                println "Updating ${entry.key} to ${entry.value} in file ${f}"
                ant.replace(file: f, token: entry.key, value: entry.value)
              }
            }
          }
        }
      
      }
    </insert>
  </baseBuildGradleAdditions>


  <!-- optional additions to GameActivity onStart in GameActivity.java -->
  <gameActivityOnStartAdditions>
    <!-- AND-11: UE4 / ≤5.2 compat only — no-op on newer engines. UE 5.7's GameActivity template already
         registers this receiver with RECEIVER_EXPORTED, so the target line is absent and this <replace>
         patches nothing. Detect presence first and <log> which path applied, so packaging output is honest. -->
    <setStringContains result="bHasLegacyRegisterReceiver" source="$S(Output)"
        find="registerReceiver(consoleCmdReceiver, new IntentFilter(Intent.ACTION_RUN));"/>
    <if condition="bHasLegacyRegisterReceiver">
      <true>
        <log text="Stash Android -> patching legacy registerReceiver(ACTION_RUN) with RECEIVER_EXPORTED (UE4 / ≤5.2 compat)"/>
        <replace find="registerReceiver(consoleCmdReceiver, new IntentFilter(Intent.ACTION_RUN));"
                 with="registerReceiver(consoleCmdReceiver, new IntentFilter(Intent.ACTION_RUN), RECEIVER_EXPORTED);"/>
      </true>
      <false>
        <log text="Stash Android -> registerReceiver(ACTION_RUN) target not found (UE 5.3+ already exports it); skipping RECEIVER_EXPORTED patch"/>
      </false>
    </if>
  </gameActivityOnStartAdditions>

  <!--  optional base build.gradle buildscript additions -->
  <buildscriptGradleAdditions>

  </buildscriptGradleAdditions>

  <!-- Copy pre-built Stash Native AAR to gradle project libs folder -->
  <gradleCopies>
    <copyFile src="$S(PluginDir)/ThirdParty/Android/StashNative-2.3.0.aar" dst="$S(BuildDir)/gradle/app/libs/StashNative.aar" />
  </gradleCopies>


  <!--  optional additions to generated build.xml before ${sdk.dir}/tools/ant/build.xml import -->
  <buildXmlPropertyAdditions>

  </buildXmlPropertyAdditions>


  <!-- optional minimum SDK API level required -->
  <minimumSDKAPI>

  </minimumSDKAPI>

</root>